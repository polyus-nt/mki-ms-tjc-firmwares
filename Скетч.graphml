      <data key="dData">id/ ActExpected

type/ Counter

name/ Длина payload
    </data>
      <data key="dLapkiSchemePosition"><point x="30" y="30"></point></data>
    </node>
    <node id="component_ActIndex">
      <data key="dNote">formal</data>
