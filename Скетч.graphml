  <graph id="MS1GateActuator">
    <data key="dStateMachine"></data>
    <data key="dName">Актуатор — прозрачный мост</data>
    <data key="dGeometry"><rect x="0" y="0" width="450" height="100"></rect></data>
    <node id="coreMeta">
      <data key="dNote">formal</data>
      <data key="dName">CGML_META</data>
      <data key="dData">platform/ tjc-ms1-ard-a1

standardVersion/ 1.0

platformVersion/ 1.0

lapkiVisual/ true
    </data>
    </node>
    <node id="act_idle">
      <data key="dName">Ожидание команды</data>
      <data key="dData">entry/
ActBus.setAddress(14);</data>
      <data key="dGeometry"><rect x="0" y="0" width="360" height="90"></rect></data>
      <data key="dColor">#FFFFFF</data>
    </node>
    <node id="act_command_choice">
      <data key="dVertex">choice</data>
      <data key="dGeometry"><rect x="400" y="20" width="-1" height="-1"></rect></data>
    </node>
    <node id="act_receive_payload">
      <data key="dName">Приём payload по позиции</data>
      <data key="dData"></data>
      <data key="dGeometry"><rect x="560" y="0" width="360" height="90"></rect></data>
      <data key="dColor">#FFFFFF</data>
    </node>
    <node id="act_payload_choice">
      <data key="dVertex">choice</data>
      <data key="dGeometry"><rect x="960" y="20" width="-1" height="-1"></rect></data>
    </node>
    <node id="act_forward_start">
      <data key="dName">Передача к Arduino: код</data>
      <data key="dData">entry/
ActArduino.sendPacket(ActCommand.value);
ActIndex.reset();
ActTimeout.start(2000);
ActStep.call();</data>
      <data key="dGeometry"><rect x="1120" y="0" width="360" height="90"></rect></data>
      <data key="dColor">#FFFFFF</data>
    </node>
    <node id="act_forward_choice">
      <data key="dVertex">choice</data>
      <data key="dGeometry"><rect x="1520" y="20" width="-1" height="-1"></rect></data>
    </node>
    <node id="act_forward_byte">
      <data key="dName">Передача к Arduino: payload</data>
      <data key="dData">entry/
ActRequest.peek(ActIndex.value);
ActArduino.sendPacket(ActRequest.value);
ActIndex.add(1);
ActStep.call();</data>
      <data key="dGeometry"><rect x="1680" y="0" width="360" height="90"></rect></data>
      <data key="dColor">#FFFFFF</data>
    </node>
    <node id="act_forward_count">
      <data key="dVertex">choice</data>
      <data key="dGeometry"><rect x="2080" y="20" width="-1" height="-1"></rect></data>
    </node>
    <node id="act_response_length">
      <data key="dVertex">choice</data>
      <data key="dGeometry"><rect x="2240" y="20" width="-1" height="-1"></rect></data>
    </node>
    <node id="act_wait_response">
      <data key="dName">Приём ответа Arduino по позиции</data>
      <data key="dData"></data>
      <data key="dGeometry"><rect x="2400" y="0" width="360" height="90"></rect></data>
      <data key="dColor">#FFFFFF</data>
    </node>
    <node id="act_response_first">
      <data key="dVertex">choice</data>
      <data key="dGeometry"><rect x="2800" y="20" width="-1" height="-1"></rect></data>
    </node>
    <node id="act_response_status">
      <data key="dVertex">choice</data>
      <data key="dGeometry"><rect x="2960" y="20" width="-1" height="-1"></rect></data>
    </node>
    <node id="act_response_count">
      <data key="dVertex">choice</data>
      <data key="dGeometry"><rect x="3120" y="20" width="-1" height="-1"></rect></data>
    </node>
    <node id="act_send_start">
      <data key="dName">Начало ответа центральной плате</data>
      <data key="dData">entry/
ActIndex.reset();
ActStep.call();</data>
      <data key="dGeometry"><rect x="3280" y="0" width="360" height="90"></rect></data>
      <data key="dColor">#FFFFFF</data>
    </node>
    <node id="act_send_byte">
      <data key="dName">Передача байта ответа</data>
      <data key="dData">entry/
ActResponse.peek(ActIndex.value);
ActBus.sendPacket(12, ActResponse.value);
ActIndex.add(1);
ActStep.call();</data>
      <data key="dGeometry"><rect x="3440" y="0" width="360" height="90"></rect></data>
      <data key="dColor">#FFFFFF</data>
    </node>
    <node id="act_send_choice">
      <data key="dVertex">choice</data>
      <data key="dGeometry"><rect x="3840" y="20" width="-1" height="-1"></rect></data>
    </node>
    <node id="act_invalid">
      <data key="dName">Неизвестная команда</data>
      <data key="dData">entry/
ActBus.sendPacket(12, 224);
ActStep.call();</data>
      <data key="dGeometry"><rect x="560" y="170" width="360" height="90"></rect></data>
      <data key="dColor">#FFFFFF</data>
    </node>
    <node id="act_initial">
      <data key="dVertex">initial</data>
      <data key="dGeometry"><rect x="-80" y="20" width="-1" height="-1"></rect></data>
    </node>
    <node id="act_note">
      <data key="dGeometry"><rect x="1120" y="300" width="420" height="80"></rect></data>
      <data key="dNote">informal</data>
      <data key="dData">Команда и payload пересылаются Arduino без изменений. Ответ читается как 1, 18 или 21 байт. Ошибка E0..E3 состоит из одного байта.</data>
    </node>
    <node id="component_ActBus">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT</data>
      <data key="dData">id/ ActBus

type/ SimpleBus
    </data>
      <data key="dLapkiSchemePosition"><point x="30" y="30"></point></data>
    </node>
    <node id="component_ActArduino">
