      <data key="dData">id/ ActIndex

type/ Counter

name/ Индекс байта
    </data>
      <data key="dLapkiSchemePosition"><point x="30" y="30"></point></data>
    </node>
    <node id="component_ActResponseExpected">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT</data>
      <data key="dData">id/ ActResponseExpected

type/ Counter

name/ Длина ответа
    </data>
      <data key="dLapkiSchemePosition"><point x="30" y="30"></point></data>
    </node>
    <node id="component_ActRequest">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT</data>
      <data key="dData">id/ ActRequest

type/ Array

size/ 8

name/ Payload команды
    </data>
      <data key="dLapkiSchemePosition"><point x="30" y="30"></point></data>
    </node>
    <node id="component_ActResponse">
