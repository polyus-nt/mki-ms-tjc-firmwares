    <node id="wlvfixbyxbxbuafpgxfa">
      <data key="dName">Ждем команду</data>
      <data key="dData">entry/
SimpleBus2.setAddress(13);
Counter5.set(1);
Counter2.set(2);
Counter4.set(3);
Counter3.set(4);

exit/
LED2.toggle();

</data>
      <data key="dGeometry">
        <rect x="-32.60003662109375" y="327.4000015258789" width="450" height="100"></rect>
      </data>
      <data key="dColor">#FFFFFF</data>
    </node>
    <node id="kcygaolatawvngndieud">
      <data key="dName">Коммуникация</data>
      <data key="dData">entry/
