    <node id="wowamdwmlbciuhygevez">
      <data key="dName">Ждем таймер опроса</data>
      <data key="dData">entry/
Timer3.start(50);
SimpleBus1.setAddress(12);
Counter7.set(1);
Counter9.set(2);
Counter8.set(3);
Counter10.set(99);
Counter11.set(12);
Counter24.set(6);
Counter26.set(25);

Timer5.timeout/
Counter6.add(Counter1.value);
UserSignal7.call();

UserSignal7.isCalled[Counter6.value == 0]/
Counter6.set(1);

UserSignal7.isCalled[Counter6.value == 255]/
Counter6.set(254);

</data>
      <data key="dGeometry">
        <rect x="60.199981689453125" y="136.58000076293945" width="450" height="100"></rect>
      </data>
