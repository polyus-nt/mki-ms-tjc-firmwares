<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns">
  <data key="gFormat">Cyberiada-GraphML-1.0</data>
  <key attr.name="name" attr.type="string" for="node" id="dName"></key>
  <key attr.name="data" attr.type="string" for="node" id="dData"></key>
  <key attr.name="data" attr.type="string" for="edge" id="dData"></key>
  <key attr.name="initial" attr.type="string" for="node" id="dInitial"></key>
  <key for="edge" id="dGeometry"></key>
  <key for="node" id="dGeometry"></key>
  <key for="edge" id="dColor"></key>
  <key for="node" id="dNote"></key>
  <key for="node" id="dColor"></key>
  <key for="node" id="dVertex"></key>
  <key for="node" id="dStateMachine"></key>
  <key for="edge" id="dLabelGeometry"></key>
  <graph id="ArduinoUno1">
    <data key="dStateMachine"></data>
    <data key="dName">Вспомогательная Arduino</data>
    <data key="dGeometry"><rect x="0" y="0" width="450" height="100"></rect></data>
    <node id="coreMeta">
      <data key="dNote">formal</data>
      <data key="dName">CGML_META</data>
      <data key="dData">platform/ ArduinoUno

standardVersion/ 1.0

platformVersion/ 1.0

lapkiVisual/ true
    </data>
    </node>
    <node id="aux_wait">
      <data key="dName">Ждём</data>
      <data key="dData">Button1.clicked/
LED1.toggle();</data>
      <data key="dGeometry"><rect x="80" y="20" width="360" height="90"></rect></data>
      <data key="dColor">#FFFFFF</data>
    </node>
    <node id="aux_initial">
      <data key="dVertex">initial</data>
      <data key="dGeometry"><rect x="0" y="40" width="-1" height="-1"></rect></data>
    </node>
    <node id="component_LED1">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT</data>
      <data key="dData">id/ LED1

type/ LED

pin/ 8
    </data>
      <data key="dLapkiSchemePosition"><point x="30" y="30"></point></data>
    </node>
    <node id="component_Button1">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT</data>
      <data key="dData">id/ Button1

type/ Button

pin/ 12

buttonMode/ BUTTON_PULLDOWN
    </data>
      <data key="dLapkiSchemePosition"><point x="30" y="30"></point></data>
    </node>
    <edge id="edge_1" source="aux_initial" target="aux_wait"></edge>
  </graph>
  <graph id="MS1GateSensors">
    <data key="dStateMachine"></data>
    <data key="dName">Датчики — мост фиксированного протокола</data>
    <data key="dGeometry"><rect x="0" y="0" width="450" height="100"></rect></data>
    <node id="coreMeta">
      <data key="dNote">formal</data>
      <data key="dName">CGML_META</data>
      <data key="dData">platform/ tjc-ms1-ard-a1

standardVersion/ 1.0

platformVersion/ 1.0

lapkiVisual/ true
    </data>
    </node>
    <node id="sensor_idle">
      <data key="dName">Ожидание POLL_SENSORS</data>
      <data key="dData">entry/
SensorBus.setAddress(13);</data>
      <data key="dGeometry"><rect x="0" y="0" width="360" height="90"></rect></data>
      <data key="dColor">#FFFFFF</data>
    </node>
    <node id="sensor_poll_wait">
      <data key="dName">Ожидание OK после POLL_SENSORS</data>
      <data key="dData"></data>
      <data key="dGeometry"><rect x="420" y="0" width="360" height="90"></rect></data>
      <data key="dColor">#FFFFFF</data>
    </node>
    <node id="sensor_read_wait">
      <data key="dName">Приём READ_SENSORS по позиции</data>
      <data key="dData"></data>
      <data key="dGeometry"><rect x="840" y="0" width="360" height="90"></rect></data>
      <data key="dColor">#FFFFFF</data>
    </node>
    <node id="sensor_first_choice">
      <data key="dVertex">choice</data>
      <data key="dGeometry"><rect x="1250" y="20" width="-1" height="-1"></rect></data>
    </node>
    <node id="sensor_status_choice">
      <data key="dVertex">choice</data>
      <data key="dGeometry"><rect x="1410" y="20" width="-1" height="-1"></rect></data>
    </node>
    <node id="sensor_count_choice">
      <data key="dVertex">choice</data>
      <data key="dGeometry"><rect x="1570" y="20" width="-1" height="-1"></rect></data>
    </node>
    <node id="sensor_send_error">
      <data key="dName">Передача ошибки центральной плате</data>
      <data key="dData">entry/
SensorBus.sendPacket(12, SensorArduino.lastData);
SensorStep.call();</data>
      <data key="dGeometry"><rect x="1260" y="170" width="360" height="90"></rect></data>
      <data key="dColor">#FFFFFF</data>
    </node>
    <node id="sensor_send_start">
      <data key="dName">Начало позиционной передачи</data>
      <data key="dData">entry/
SensorIndex.reset();
SensorStep.call();</data>
      <data key="dGeometry"><rect x="1680" y="170" width="360" height="90"></rect></data>
      <data key="dColor">#FFFFFF</data>
    </node>
    <node id="sensor_send_byte">
      <data key="dName">Передача следующего байта</data>
      <data key="dData">entry/
SensorResponse.peek(SensorIndex.value);
SensorBus.sendPacket(12, SensorResponse.value);
SensorIndex.add(1);
SensorStep.call();</data>
      <data key="dGeometry"><rect x="1680" y="310" width="360" height="90"></rect></data>
      <data key="dColor">#FFFFFF</data>
    </node>
    <node id="sensor_send_choice">
      <data key="dVertex">choice</data>
      <data key="dGeometry"><rect x="2090" y="330" width="-1" height="-1"></rect></data>
    </node>
    <node id="sensor_initial">
      <data key="dVertex">initial</data>
      <data key="dGeometry"><rect x="-80" y="20" width="-1" height="-1"></rect></data>
    </node>
    <node id="sensor_note">
      <data key="dGeometry"><rect x="420" y="470" width="420" height="80"></rect></data>
      <data key="dNote">informal</data>
      <data key="dData">POLL_SENSORS=0x01, затем READ_SENSORS=0x04. Успех READ: ровно 9 полей и OK. Значения полей не проверяются как маркеры.</data>
    </node>
    <node id="component_SensorBus">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT</data>
      <data key="dData">id/ SensorBus

type/ SimpleBus
    </data>
      <data key="dLapkiSchemePosition"><point x="30" y="30"></point></data>
    </node>
    <node id="component_SensorArduino">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT</data>
      <data key="dData">id/ SensorArduino

type/ ArduinoAdapter
    </data>
      <data key="dLapkiSchemePosition"><point x="30" y="30"></point></data>
    </node>
    <node id="component_SensorTimeout">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT</data>
      <data key="dData">id/ SensorTimeout

type/ Timer
    </data>
      <data key="dLapkiSchemePosition"><point x="30" y="30"></point></data>
    </node>
    <node id="component_SensorStep">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT</data>
      <data key="dData">id/ SensorStep

type/ UserSignal
    </data>
      <data key="dLapkiSchemePosition"><point x="30" y="30"></point></data>
    </node>
    <node id="component_SensorIndex">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT</data>
      <data key="dData">id/ SensorIndex

type/ Counter

name/ Индекс байта READ_SENSORS
    </data>
      <data key="dLapkiSchemePosition"><point x="30" y="30"></point></data>
    </node>
    <node id="component_SensorResponse">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT</data>
      <data key="dData">id/ SensorResponse

type/ Array

size/ 10

name/ Ответ READ_SENSORS
    </data>
      <data key="dLapkiSchemePosition"><point x="30" y="30"></point></data>
    </node>
    <edge id="edge_2" source="sensor_initial" target="sensor_idle"></edge>
    <edge id="edge_3" source="sensor_idle" target="sensor_poll_wait">
      <data key="dData">SensorBus.packetReceived[SensorBus.lastData == 1]/
SensorArduino.sendPacket(1);
SensorTimeout.start(2000);</data>
      <data key="dLabelGeometry"><point x="0" y="0"></point></data>
    </edge>
    <edge id="edge_4" source="sensor_poll_wait" target="sensor_read_wait">
      <data key="dData">SensorArduino.packetReceived[SensorArduino.lastData == 3]/
SensorArduino.sendPacket(4);
SensorIndex.reset();
SensorTimeout.start(2000);</data>
      <data key="dLabelGeometry"><point x="0" y="0"></point></data>
    </edge>
    <edge id="edge_5" source="sensor_poll_wait" target="sensor_send_error">
      <data key="dData">SensorArduino.packetReceived[SensorArduino.lastData != 3]/
    </data>
      <data key="dLabelGeometry"><point x="0" y="0"></point></data>
    </edge>
    <edge id="edge_6" source="sensor_read_wait" target="sensor_first_choice">
      <data key="dData">SensorArduino.packetReceived/
SensorResponse.set(SensorIndex.value, SensorArduino.lastData);
SensorIndex.add(1);
SensorTimeout.start(2000);</data>
      <data key="dLabelGeometry"><point x="0" y="0"></point></data>
    </edge>
    <edge id="edge_7" source="sensor_first_choice" target="sensor_status_choice">
      <data key="dData">[SensorIndex.value == 1]/
    </data>
      <data key="dLabelGeometry"><point x="0" y="0"></point></data>
    </edge>
    <edge id="edge_8" source="sensor_first_choice" target="sensor_count_choice">
      <data key="dData">[else]/
    </data>
      <data key="dLabelGeometry"><point x="0" y="0"></point></data>
    </edge>
    <edge id="edge_9" source="sensor_status_choice" target="sensor_send_error">
      <data key="dData">[SensorArduino.lastData == 224]/
    </data>
      <data key="dLabelGeometry"><point x="0" y="0"></point></data>
    </edge>
    <edge id="edge_10" source="sensor_status_choice" target="sensor_send_error">
      <data key="dData">[SensorArduino.lastData == 225]/
    </data>
      <data key="dLabelGeometry"><point x="0" y="0"></point></data>
    </edge>
    <edge id="edge_11" source="sensor_status_choice" target="sensor_send_error">
      <data key="dData">[SensorArduino.lastData == 226]/
    </data>
      <data key="dLabelGeometry"><point x="0" y="0"></point></data>
    </edge>
    <edge id="edge_12" source="sensor_status_choice" target="sensor_send_error">
      <data key="dData">[SensorArduino.lastData == 227]/
    </data>
      <data key="dLabelGeometry"><point x="0" y="0"></point></data>
    </edge>
    <edge id="edge_13" source="sensor_status_choice" target="sensor_count_choice">
      <data key="dData">[else]/
    </data>
      <data key="dLabelGeometry"><point x="0" y="0"></point></data>
    </edge>
    <edge id="edge_14" source="sensor_count_choice" target="sensor_send_start">
      <data key="dData">[SensorIndex.value == 10]/
    </data>
      <data key="dLabelGeometry"><point x="0" y="0"></point></data>
    </edge>
    <edge id="edge_15" source="sensor_count_choice" target="sensor_read_wait">
      <data key="dData">[else]/
    </data>
      <data key="dLabelGeometry"><point x="0" y="0"></point></data>
    </edge>
    <edge id="edge_16" source="sensor_send_error" target="sensor_idle">
      <data key="dData">SensorStep.isCalled/
    </data>
      <data key="dLabelGeometry"><point x="0" y="0"></point></data>
    </edge>
    <edge id="edge_17" source="sensor_send_start" target="sensor_send_byte">
      <data key="dData">SensorStep.isCalled/
    </data>
      <data key="dLabelGeometry"><point x="0" y="0"></point></data>
    </edge>
    <edge id="edge_18" source="sensor_send_byte" target="sensor_send_choice">
      <data key="dData">SensorStep.isCalled/
    </data>
      <data key="dLabelGeometry"><point x="0" y="0"></point></data>
    </edge>
    <edge id="edge_19" source="sensor_send_choice" target="sensor_idle">
      <data key="dData">[SensorIndex.value == 10]/
    </data>
      <data key="dLabelGeometry"><point x="0" y="0"></point></data>
    </edge>
    <edge id="edge_20" source="sensor_send_choice" target="sensor_send_byte">
      <data key="dData">[else]/
    </data>
      <data key="dLabelGeometry"><point x="0" y="0"></point></data>
    </edge>
    <edge id="edge_21" source="sensor_poll_wait" target="sensor_idle">
      <data key="dData">SensorTimeout.timeout/
    </data>
      <data key="dLabelGeometry"><point x="0" y="0"></point></data>
    </edge>
    <edge id="edge_22" source="sensor_read_wait" target="sensor_idle">
      <data key="dData">SensorTimeout.timeout/
    </data>
      <data key="dLabelGeometry"><point x="0" y="0"></point></data>
    </edge>
  </graph>
  <graph id="MS1MainProtocol">
    <data key="dStateMachine"></data>
    <data key="dName">Центральная плата — маршрутизатор протокола</data>
    <data key="dGeometry"><rect x="0" y="0" width="450" height="100"></rect></data>
    <node id="coreMeta">
      <data key="dNote">formal</data>
      <data key="dName">CGML_META</data>
      <data key="dData">platform/ tjc-ms1-main-a4

standardVersion/ 1.0

platformVersion/ 1.0

lapkiVisual/ true
    </data>
    </node>
    <node id="main_idle">
      <data key="dName">Idle: управление или периодический цикл</data>
      <data key="dData">entry/
MainBus.setAddress(12);
MainPeriodic.start(2000);</data>
      <data key="dGeometry"><rect x="0" y="0" width="360" height="90"></rect></data>
      <data key="dColor">#FFFFFF</data>
    </node>
    <node id="main_control_command">
      <data key="dName">Ожидание кода команды ПК</data>
      <data key="dData"></data>
      <data key="dGeometry"><rect x="420" y="0" width="360" height="90"></rect></data>
      <data key="dColor">#FFFFFF</data>
    </node>
    <node id="main_command_choice">
      <data key="dVertex">choice</data>
      <data key="dGeometry"><rect x="820" y="20" width="-1" height="-1"></rect></data>
    </node>
    <node id="main_receive_payload">
      <data key="dName">Приём payload ПК по позиции</data>
      <data key="dData"></data>
      <data key="dGeometry"><rect x="980" y="0" width="360" height="90"></rect></data>
      <data key="dColor">#FFFFFF</data>
    </node>
    <node id="main_payload_choice">
      <data key="dVertex">choice</data>
      <data key="dGeometry"><rect x="1380" y="20" width="-1" height="-1"></rect></data>
    </node>
    <node id="main_forward_start">
      <data key="dName">Пересылка актуатору: код</data>
      <data key="dData">entry/
MainBus.sendPacket(14, MainCommand.value);
MainIndex.reset();
MainFlow.set(1);
MainTimeout.start(2000);
MainStep.call();</data>
      <data key="dGeometry"><rect x="1540" y="0" width="360" height="90"></rect></data>
      <data key="dColor">#FFFFFF</data>
    </node>
    <node id="main_forward_choice">
      <data key="dVertex">choice</data>
      <data key="dGeometry"><rect x="1940" y="20" width="-1" height="-1"></rect></data>
    </node>
    <node id="main_forward_byte">
      <data key="dName">Пересылка актуатору: payload</data>
      <data key="dData">entry/
MainRequest.peek(MainIndex.value);
MainBus.sendPacket(14, MainRequest.value);
MainIndex.add(1);
MainStep.call();</data>
      <data key="dGeometry"><rect x="2100" y="0" width="360" height="90"></rect></data>
      <data key="dColor">#FFFFFF</data>
    </node>
    <node id="main_forward_count">
      <data key="dVertex">choice</data>
      <data key="dGeometry"><rect x="2500" y="20" width="-1" height="-1"></rect></data>
    </node>
    <node id="main_response_length">
      <data key="dVertex">choice</data>
      <data key="dGeometry"><rect x="2660" y="20" width="-1" height="-1"></rect></data>
    </node>
    <node id="main_wait_actuator">
      <data key="dName">Приём ответа актуатора по позиции</data>
      <data key="dData"></data>
      <data key="dGeometry"><rect x="2820" y="0" width="360" height="90"></rect></data>
      <data key="dColor">#FFFFFF</data>
    </node>
    <node id="main_response_first">
      <data key="dVertex">choice</data>
      <data key="dGeometry"><rect x="3220" y="20" width="-1" height="-1"></rect></data>
    </node>
    <node id="main_response_status">
      <data key="dVertex">choice</data>
      <data key="dGeometry"><rect x="3380" y="20" width="-1" height="-1"></rect></data>
    </node>
    <node id="main_response_count">
      <data key="dVertex">choice</data>
      <data key="dGeometry"><rect x="3540" y="20" width="-1" height="-1"></rect></data>
    </node>
    <node id="main_flow_choice">
      <data key="dVertex">choice</data>
      <data key="dGeometry"><rect x="3700" y="20" width="-1" height="-1"></rect></data>
    </node>
    <node id="main_send_response_start">
      <data key="dName">CONTROL_RESPONSE: заголовок</data>
      <data key="dData">entry/
MainBus.sendPacket(99, 18);
MainBus.sendPacket(99, MainCommand.value);
MainIndex.reset();
MainStep.call();</data>
      <data key="dGeometry"><rect x="3860" y="0" width="360" height="90"></rect></data>
      <data key="dColor">#FFFFFF</data>
    </node>
    <node id="main_send_response_byte">
      <data key="dName">CONTROL_RESPONSE: тело</data>
      <data key="dData">entry/
MainResponse.peek(MainIndex.value);
MainBus.sendPacket(99, MainResponse.value);
MainIndex.add(1);
MainStep.call();</data>
      <data key="dGeometry"><rect x="4260" y="0" width="360" height="90"></rect></data>
      <data key="dColor">#FFFFFF</data>
    </node>
    <node id="main_send_response_choice">
      <data key="dVertex">choice</data>
      <data key="dGeometry"><rect x="4660" y="20" width="-1" height="-1"></rect></data>
    </node>
    <node id="main_invalid">
      <data key="dName">Ответ на неизвестную команду</data>
      <data key="dData">entry/
MainBus.sendPacket(99, 18);
MainBus.sendPacket(99, MainCommand.value);
MainBus.sendPacket(99, 224);
MainStep.call();</data>
      <data key="dGeometry"><rect x="980" y="170" width="360" height="90"></rect></data>
      <data key="dColor">#FFFFFF</data>
    </node>
    <node id="main_wait_sensors">
      <data key="dName">Приём READ_SENSORS по позиции</data>
      <data key="dData"></data>
      <data key="dGeometry"><rect x="420" y="340" width="360" height="90"></rect></data>
      <data key="dColor">#FFFFFF</data>
    </node>
    <node id="main_sensor_first">
      <data key="dVertex">choice</data>
      <data key="dGeometry"><rect x="820" y="360" width="-1" height="-1"></rect></data>
    </node>
    <node id="main_sensor_status">
      <data key="dVertex">choice</data>
      <data key="dGeometry"><rect x="980" y="360" width="-1" height="-1"></rect></data>
    </node>
    <node id="main_sensor_count">
      <data key="dVertex">choice</data>
      <data key="dGeometry"><rect x="1140" y="360" width="-1" height="-1"></rect></data>
    </node>
    <node id="main_sensor_final">
      <data key="dVertex">choice</data>
      <data key="dGeometry"><rect x="1300" y="360" width="-1" height="-1"></rect></data>
    </node>
    <node id="main_calculate_door">
      <data key="dName">Вычисление состояния двери</data>
      <data key="dData">entry/
MainDoorSum.set(0);
MainSensors.peek(1);
MainDoorSum.add(MainSensors.value);
MainSensors.peek(2);
MainDoorSum.add(MainSensors.value);
MainSensors.peek(3);
MainDoorSum.add(MainSensors.value);
MainStep.call();</data>
      <data key="dGeometry"><rect x="1460" y="340" width="360" height="90"></rect></data>
      <data key="dColor">#FFFFFF</data>
    </node>
    <node id="main_door_choice">
      <data key="dVertex">choice</data>
      <data key="dGeometry"><rect x="1860" y="360" width="-1" height="-1"></rect></data>
    </node>
    <node id="main_door_closed">
      <data key="dName">Дверь закрыта</data>
      <data key="dData">entry/
MainDoorOpen.reset();
MainDoorStage.reset();
MainStep.call();</data>
      <data key="dGeometry"><rect x="2020" y="300" width="360" height="90"></rect></data>
      <data key="dColor">#FFFFFF</data>
    </node>
    <node id="main_door_open">
      <data key="dName">Дверь открыта</data>
      <data key="dData">entry/
MainDoorOpen.set(1);
MainDoorStage.set(1);
MainStep.call();</data>
      <data key="dGeometry"><rect x="2020" y="420" width="360" height="90"></rect></data>
      <data key="dColor">#FFFFFF</data>
    </node>
    <node id="main_send_environment">
      <data key="dName">UPDATE_ENVIRONMENT</data>
      <data key="dData">entry/
MainBus.sendPacket(14, 6);
MainSensors.peek(4);
MainBus.sendPacket(14, MainSensors.value);
MainSensors.peek(5);
MainBus.sendPacket(14, MainSensors.value);
MainSensors.peek(8);
MainBus.sendPacket(14, MainSensors.value);
MainBus.sendPacket(14, MainDoorOpen.value);
MainBus.sendPacket(14, MainDoorStage.value);
MainFlow.set(2);
MainResponseExpected.set(1);
MainIndex.reset();
MainTimeout.start(2000);
MainStep.call();</data>
      <data key="dGeometry"><rect x="2420" y="340" width="360" height="90"></rect></data>
      <data key="dColor">#FFFFFF</data>
    </node>
    <node id="main_environment_status">
      <data key="dVertex">choice</data>
      <data key="dGeometry"><rect x="3860" y="360" width="-1" height="-1"></rect></data>
    </node>
    <node id="main_get_state">
      <data key="dName">GET_ACTUATOR_STATE</data>
      <data key="dData">entry/
MainBus.sendPacket(14, 1);
MainFlow.set(3);
MainResponseExpected.set(21);
MainIndex.reset();
MainTimeout.start(2000);
MainStep.call();</data>
      <data key="dGeometry"><rect x="4020" y="340" width="360" height="90"></rect></data>
      <data key="dColor">#FFFFFF</data>
    </node>
    <node id="main_state_final">
      <data key="dVertex">choice</data>
      <data key="dGeometry"><rect x="3860" y="500" width="-1" height="-1"></rect></data>
    </node>
    <node id="main_prepare_telemetry">
      <data key="dName">Сборка 29-байтовой телеметрии</data>
      <data key="dData">entry/
MainTelemetry.set(0, 1);
MainSensors.peek(0);
MainTelemetry.set(1, MainSensors.value);
MainSensors.peek(4);
MainTelemetry.set(2, MainSensors.value);
MainSensors.peek(5);
MainTelemetry.set(3, MainSensors.value);
MainSensors.peek(6);
MainTelemetry.set(4, MainSensors.value);
MainSensors.peek(7);
MainTelemetry.set(5, MainSensors.value);
MainSensors.peek(8);
MainTelemetry.set(6, MainSensors.value);
MainResponse.peek(0);
MainTelemetry.set(7, MainResponse.value);
MainTelemetry.set(8, MainDoorOpen.value);
MainTelemetry.set(9, MainDoorStage.value);
MainResponse.peek(1);
MainTelemetry.set(10, MainResponse.value);
MainResponse.peek(2);
MainTelemetry.set(11, MainResponse.value);
MainResponse.peek(3);
MainTelemetry.set(12, MainResponse.value);
MainResponse.peek(4);
MainTelemetry.set(13, MainResponse.value);
MainResponse.peek(5);
MainTelemetry.set(14, MainResponse.value);
MainResponse.peek(6);
MainTelemetry.set(15, MainResponse.value);
MainResponse.peek(7);
MainTelemetry.set(16, MainResponse.value);
MainResponse.peek(8);
MainTelemetry.set(17, MainResponse.value);
MainResponse.peek(9);
MainTelemetry.set(18, MainResponse.value);
MainResponse.peek(10);
MainTelemetry.set(19, MainResponse.value);
MainResponse.peek(11);
MainTelemetry.set(20, MainResponse.value);
MainResponse.peek(12);
MainTelemetry.set(21, MainResponse.value);
MainResponse.peek(13);
MainTelemetry.set(22, MainResponse.value);
MainResponse.peek(14);
MainTelemetry.set(23, MainResponse.value);
MainResponse.peek(15);
MainTelemetry.set(24, MainResponse.value);
MainResponse.peek(16);
MainTelemetry.set(25, MainResponse.value);
MainResponse.peek(17);
MainTelemetry.set(26, MainResponse.value);
MainResponse.peek(18);
MainTelemetry.set(27, MainResponse.value);
MainResponse.peek(19);
MainTelemetry.set(28, MainResponse.value);
MainBus.sendPacket(99, 12);
MainIndex.reset();
MainStep.call();</data>
      <data key="dGeometry"><rect x="4180" y="500" width="360" height="90"></rect></data>
      <data key="dColor">#FFFFFF</data>
    </node>
    <node id="main_send_telemetry_byte">
      <data key="dName">Передача байта телеметрии</data>
      <data key="dData">entry/
MainTelemetry.peek(MainIndex.value);
MainBus.sendPacket(99, MainTelemetry.value);
MainIndex.add(1);
MainStep.call();</data>
      <data key="dGeometry"><rect x="4580" y="500" width="360" height="90"></rect></data>
      <data key="dColor">#FFFFFF</data>
    </node>
    <node id="main_telemetry_choice">
      <data key="dVertex">choice</data>
      <data key="dGeometry"><rect x="4980" y="520" width="-1" height="-1"></rect></data>
    </node>
    <node id="main_end_telemetry">
      <data key="dName">Завершение телеметрии</data>
      <data key="dData">entry/
MainBus.sendPacket(99, 12);
MainStep.call();</data>
      <data key="dGeometry"><rect x="5140" y="500" width="360" height="90"></rect></data>
      <data key="dColor">#FFFFFF</data>
    </node>
